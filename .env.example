# .env.example — 이 파일을 .env로 복사한 뒤 실제 값을 채워 넣으세요.
#   cp .env.example .env
# .env는 gitignore 대상입니다. 실제 비밀정보를 이 파일에 적지 마세요.

# JWT 서명 키 (base64 인코딩된 32바이트 이상 문자열)
JWT_SECRET=

# MySQL 계정
I_ROUTE_DB_USERNAME=
I_ROUTE_DB_PASSWORD=

# 메일 발송 계정
MAIL_USERNAME=
MAIL_PASSWORD=

# 카카오 로그인 (https://developers.kakao.com 앱 설정)
KAKAO_CLIENT_ID=
KAKAO_REST_API_KEY=
KAKAO_REDIRECT_URI=http://localhost:8080/api/auth/kakao/callback

# FastAPI AI 서버 주소 (로컬: http://localhost:8082, ngrok 사용 시 해당 URL)
AI_SERVER_URL=http://localhost:8082

# start-server.ps1이 기동 후 토큰을 뽑아볼 테스트 계정 비밀번호
TEST_PARENT_PASSWORD=
TEST_ADMIN_PASSWORD=
TEST_ACADEMY_PASSWORD=
TEST_NOPREM_PASSWORD=
